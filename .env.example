DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key

# Geocoding API key (optional - Nominatim works without one)
# If using OpenRouteService for geocoding, provide your free API key here
GEOCODING_API_KEY=

# Routing API key (OSRM is free and keyless)
ROUTING_API_KEY=

# Station search radius around the driving route (miles)
ROUTE_STATION_RADIUS_MILES=10

# Vehicle parameters
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10

# Cache timeout in seconds (default: 24 hours)
CACHE_TIMEOUT=86400
